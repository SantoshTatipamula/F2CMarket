rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public product catalog
    match /products/{productId} {
      allow read: if true;

      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.farmerId;

      allow update, delete: if request.auth != null &&
                            request.auth.uid == resource.data.farmerId;
    }

    // Any authenticated user (including anonymous users) can read users.
    // Users can only modify their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.auth.uid == userId;
      allow update, delete: if request.auth != null &&
                            request.auth.uid == userId;
    }

    // Orders
    match /orders/{orderId} {
      allow create: if request.auth != null;

      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.consumerId ||
        (resource.data.farmerIds is list &&
         request.auth.uid in resource.data.farmerIds)
      );

      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.consumerId;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow create: if request.auth != null;

      allow read, update, delete: if request.auth != null &&
                                  request.auth.uid == resource.data.userId;
    }

    // Product Reviews
    match /productReviews/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.consumerId;

      allow update, delete: if request.auth != null &&
                            request.auth.uid == resource.data.consumerId;
    }

    // Feedback
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Cart
    match /carts/{cartId} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == cartId;
    }

    // Wishlist
    match /wishlists/{wishlistId} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == wishlistId;
    }

    // Saved Locations
    match /locations/{locationId} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == locationId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}