rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to public collections for authenticated users.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.farmerId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.token.admin == true ||
        (resource.data.farmerIds is list && request.auth.uid in resource.data.farmerIds) ||
        (resource.data.items is list && request.auth.uid in resource.data.items.map(item => item.farmerId))
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.token.admin == true ||
        (resource.data.farmerIds is list && request.auth.uid in resource.data.farmerIds) ||
        (resource.data.items is list && request.auth.uid in resource.data.items.map(item => item.farmerId))
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.token.admin == true
      );
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    match /wishlists/{wishlistId} {
      allow read, write: if request.auth != null && request.auth.uid == wishlistId;
    }

    match /locations/{locationId} {
      allow read, write: if request.auth != null && request.auth.uid == locationId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
